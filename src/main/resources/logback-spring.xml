<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- Spring Application properties integration -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="library-management-system"/>
    <springProperty scope="context" name="appEnv" source="info.app.environment" defaultValue="production"/>

    <!-- Variable definitions -->
    <property name="LOG_PATH" value="logs"/>
    <property name="LOG_FILE" value="application-cloudwatch.json"/>

    <!-- =================================================================== -->
    <!-- 1. JSON Console Appender (Targeted for AWS ECS / EKS / Docker / CloudWatch) -->
    <!-- =================================================================== -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- Timestamp formatted in ISO 8601 for CloudWatch Log Insights -->
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <mdc/>
                <context/>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>25</shortenedClassNameLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
                <!-- Custom metadata for CloudWatch filtering and query indexing -->
                <pattern>
                    <pattern>
                        {
                            "application": "${appName}",
                            "environment": "${appEnv}",
                            "log_source": "spring-boot"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- =================================================================== -->
    <!-- 2. JSON Rolling File Appender (For AWS CloudWatch Agent file tailing) -->
    <!-- =================================================================== -->
    <appender name="CLOUDWATCH_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Daily rollover with compression -->
            <fileNamePattern>${LOG_PATH}/archived/application-cloudwatch-%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <mdc/>
                <context/>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>30</maxDepthPerThrowable>
                        <maxLength>2048</maxLength>
                        <shortenedClassNameLength>25</shortenedClassNameLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
                <pattern>
                    <pattern>
                        {
                            "application": "${appName}",
                            "environment": "${appEnv}",
                            "log_source": "cloudwatch-agent-file"
                        }
                    </pattern>
                </pattern>
            </providers>
        </encoder>
    </appender>

    <!-- =================================================================== -->
    <!-- 3. Human-readable Console Appender (for local interactive debug)   -->
    <!-- =================================================================== -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Specific Loggers Configuration -->
    <logger name="com.rit.library" level="DEBUG" />
    <logger name="org.springframework.boot.actuate" level="INFO" />
    <logger name="org.springframework.web" level="INFO" />

    <!-- Local environment profile (optional plain text console) -->
    <springProfile name="local">
        <root level="INFO">
            <appender-ref ref="CONSOLE_TEXT" />
        </root>
    </springProfile>

    <!-- Default / Non-local profile: JSON formatted console and CloudWatch file -->
    <springProfile name="!local">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON" />
            <appender-ref ref="CLOUDWATCH_FILE" />
        </root>
    </springProfile>

</configuration>
